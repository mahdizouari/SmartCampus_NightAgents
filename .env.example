# =============================================================================
# SmartCampus AI — Root Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git !
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="SmartCampus AI"
VERSION=0.1.0

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
# Host port (5432 may already be used by another local PG instance)
POSTGRES_PORT=5433
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_secret
POSTGRES_DB=smartcampus_db

# Dedicated least-privilege application credentials (SA-16)
APP_DB_USER=smartcampus_app
APP_DB_PASSWORD=smartcampus_app_secret

# Full connection URL used by FastAPI / SQLAlchemy with asyncpg driver
DATABASE_URL=postgresql+asyncpg://smartcampus_app:smartcampus_app_secret@postgres:5432/smartcampus_db

# Connection pooling settings (SA-16)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
GUEST_SESSION_COOKIE_NAME=smartcampus_guest_session
GUEST_SESSION_TTL_SECONDS=604800
RATE_LIMIT_GUEST_IP_PER_MINUTE=30
RATE_LIMIT_GUEST_CHAT_PER_MINUTE=15

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change_me_in_production_use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Connection (SA-36 — 100% Free Open-Source <=9B via Local Ollama) ──────
# Selected models (Apache 2.0): qwen3:8b | qwen2.5:7b-instruct | smartcampus-vision-8b (QLoRA GGUF)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0
LLM_FALLBACK_TO_MOCK=true

# ── VLM Transcript Extraction (Bonus-1 / SA-42: VISION 1.4 Reader via Ollama) ─
# Selected VLM (Apache 2.0, <=8B): qwen2.5vl:7b (or qwen3-vl:8b)
VLM_PROVIDER=ollama
VLM_BASE_URL=http://host.docker.internal:11434/v1
VLM_API_KEY=
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT_SECONDS=90.0
VLM_CONFIDENCE_THRESHOLD=0.85
VLM_FALLBACK_TO_LOCAL_PARSER=true

# ── RAG Embeddings & Reranking (SA-54 / SA-61: BAAI/bge-m3 1024d + pgvector) ─
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_FALLBACK_TO_MOCK=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_MIN_RELEVANCE_SCORE=0.25

# ── Speech-to-Text / Whisper Audio Transcription (Bonus-3: Voice Notes) ──────
# Default provider: Groq (inherits LLM_BASE_URL and LLM_API_KEY when unset)
# STT_API_KEY or OPENAI_API_KEY can be provided, or defaults to LLM_API_KEY.
# For OpenAI Whisper: set WHISPER_BASE_URL=https://api.openai.com/v1 and WHISPER_MODEL=whisper-1
OPENAI_API_KEY=
STT_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_BASE_URL=
WHISPER_TIMEOUT_SECONDS=60.0

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

