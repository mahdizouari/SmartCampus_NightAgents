# =============================================================================
# SmartCampus AI — Root Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git !
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="SmartCampus AI"
VERSION=0.1.0

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5433   # host port (5432 may already be used by another local PG instance)
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_secret
POSTGRES_DB=smartcampus_db

# Full connection URL used by FastAPI / SQLAlchemy / Alembic
DATABASE_URL=postgresql+asyncpg://smartcampus:smartcampus_secret@postgres:5432/smartcampus_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change_me_in_production_use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

