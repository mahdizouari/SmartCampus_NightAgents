# SmartCampus AI — Backend Environment Configuration
PROJECT_NAME="SmartCampus AI"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS settings (list of origins allowed to connect, e.g. Next.js frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database settings (PostgreSQL 16 + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="smartcampus_app"
POSTGRES_PASSWORD="smartcampus_app_secret"
POSTGRES_DB="smartcampus_db"
DATABASE_URL="postgresql+asyncpg://smartcampus_app:smartcampus_app_secret@localhost:5433/smartcampus_db"

# Connection pooling (SA-16)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis settings (Hot conversation memory & guest sessions)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
REDIS_CHAT_HISTORY_TTL=604800
REDIS_CHAT_MAX_MESSAGES=16
REDIS_GUEST_SESSION_TTL=86400

# Guest sessions & rate limiting (SA-25)
GUEST_SESSION_COOKIE_NAME="smartcampus_guest_session"
GUEST_SESSION_TTL_SECONDS=604800
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GUEST_IP_PER_MINUTE=30
RATE_LIMIT_GUEST_SESSION_PER_MINUTE=30
RATE_LIMIT_GUEST_CHAT_PER_MINUTE=15

# LLM Connection (SA-36 — 100% Free Open-Source <=9B via Local Ollama)
# Selected models (Apache 2.0): qwen3:8b | qwen2.5:7b-instruct | smartcampus-vision-8b (QLoRA GGUF)
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://host.docker.internal:11434/v1"
LLM_API_KEY=""
LLM_MODEL="qwen3:8b"
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0
LLM_FALLBACK_TO_MOCK=true

# VLM Transcript Extraction (Bonus-1 / SA-42: VISION 1.4 Reader via Local Ollama)
# Selected VLM (Apache 2.0, <=8B): qwen2.5vl:7b (or qwen3-vl:8b)
VLM_PROVIDER="ollama"
VLM_BASE_URL=""
VLM_API_KEY=""
VLM_MODEL="qwen2.5vl:7b"
VLM_TIMEOUT_SECONDS=90.0
VLM_CONFIDENCE_THRESHOLD=0.85
VLM_FALLBACK_TO_LOCAL_PARSER=true

# RAG Embeddings & Reranking (SA-54 / SA-61: BAAI/bge-m3 1024d + pgvector)
EMBEDDING_PROVIDER="ollama"
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="bge-m3"
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_FALLBACK_TO_MOCK=true
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
RAG_MIN_RELEVANCE_SCORE=0.25

# Speech-to-Text / Whisper Audio Transcription (Bonus-3: Voice Notes)
# Local keyless Whisper STT server (faster-whisper / OpenAI-compatible HTTP endpoint)
WHISPER_PROVIDER="local"
WHISPER_BASE_URL="http://host.docker.internal:8001/v1"
WHISPER_MODEL="whisper-large-v3"
WHISPER_API_KEY=""
STT_API_KEY=""
OPENAI_API_KEY=""
WHISPER_TIMEOUT_SECONDS=60.0