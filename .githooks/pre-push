#!/usr/bin/env bash
# =============================================================================
# Local pre-push hook — runs BEFORE git push sends commits to GitHub.
# Enable once per clone with: git config core.hooksPath .githooks
# =============================================================================

set -euo pipefail

echo "==> [pre-push] Running local checks before push..."

# 1. Block accidental .env commits
if git ls-files | grep -E '(^|/)\.env(\..*)?$' | grep -v '\.env\.example$'; then
  echo "ERROR: A .env file is tracked in git! Unstage/remove it before pushing."
  exit 1
fi

# 2. Validate shell scripts
for f in scripts/*.sh .githooks/*; do
  if [ -f "$f" ]; then
    bash -n "$f"
  fi
done

# 3. Backend checks (when backend/ exists and dependencies are installed locally)
if [ -d "backend" ]; then
  echo "==> [pre-push] Checking backend/..."
  if [ -x "backend/.venv/bin/ruff" ]; then
    (cd backend && .venv/bin/ruff check .)
  elif command -v ruff >/dev/null 2>&1; then
    (cd backend && ruff check .)
  else
    echo "Notice: ruff not installed locally — skipping local backend lint (GitHub CI will run it)."
  fi

  if [ -d "backend/tests" ] || find backend -maxdepth 3 -name "test_*.py" | grep -q .; then
    if [ -x "backend/.venv/bin/pytest" ]; then
      (cd backend && .venv/bin/pytest -q)
    elif python3 -c "import fastapi, pytest" >/dev/null 2>&1; then
      (cd backend && pytest -q)
    else
      echo "Notice: backend venv/deps not installed locally — skipping local pytest (GitHub CI will run it)."
    fi
  fi
fi

# 4. Frontend checks (when frontend/node_modules is installed locally)
if [ -f "frontend/package.json" ] && command -v npm >/dev/null 2>&1; then
  if [ -d "frontend/node_modules" ]; then
    echo "==> [pre-push] Checking frontend/..."
    (cd frontend && npm run lint --if-present)
  else
    echo "Notice: frontend/node_modules not installed — skipping local lint (GitHub CI will run it)."
  fi
fi

echo "==> [pre-push] All checks passed!"

